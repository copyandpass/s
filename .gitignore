# .gitignore - Git에서 추적하지 않을 파일 목록

# 🔐 환경 변수 및 비밀 정보
.env
.env.local
.env.*.local
.env.production

# 🐍 Python 관련
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# 📦 가상 환경
venv/
ENV/
env/
.venv

# 🧪 테스트 및 커버리지
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/

# 🎨 IDE 및 에디터
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
*.sublime-project
*.sublime-workspace

# 🐳 Docker 관련
docker-compose.override.yml
docker-compose.local.yml
.docker/

# 📊 데이터베이스
*.db
*.sqlite
*.sqlite3
dump.rdb

# 📁 시스템 파일
.DS_Store
Thumbs.db
*.log
logs/

# 📤 배포 관련
dist/
build/
*.egg-info/

# 🔍 기타
.classpath
.project
.settings/
*.iml
.gradle/
